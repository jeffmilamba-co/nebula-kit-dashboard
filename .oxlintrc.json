{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "env": { "browser": true, "es2024": true },
  "rules": {
    // React 17+ JSX runtime: React doesn't need to be in scope.
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "error",
    "react/no-unstable-nested-components": "error",
    "react/jsx-no-constructed-context-values": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "eqeqeq": ["error", "smart"],
    "no-console": ["error", { "allow": ["error", "warn"] }],
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      // The data layer sorts arrays it has just built, in place, on purpose: toSorted() would copy
      // hundreds of thousands of elements on the load path for no benefit.
      "files": ["src/data/**"],
      "rules": { "unicorn/no-array-sort": "off" }
    },
    {
      // Browser steps in a test are sequential by nature.
      "files": ["e2e/**"],
      "rules": { "no-await-in-loop": "off" }
    },
    {
      // Command-line tools report to the console.
      "files": ["scripts/**"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["dist", "playwright-report", "test-results"]
}
